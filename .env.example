# Google Gemini API Key (get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default free-tier model: gemini-3.5-flash-lite)
# Note: Google regularly updates free-tier model availability and deprecates older models.
# Check https://ai.google.dev/pricing and https://aistudio.google.com/ for currently available models.
# Supported free-tier alternatives: gemini-3.6-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Server port
PORT=3000
